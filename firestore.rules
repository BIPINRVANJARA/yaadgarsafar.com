rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Packages: Public can only read published packages; Admins can do all
    match /packages/{packageId} {
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;

      match /itinerary/{dayId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /hotels/{hotelId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /flights/{flightId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /transfers/{transferId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /activities/{activityId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /departureDates/{dateId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Confidential Supplier Pricing: STRICTLY Admin only
    match /package_commercials/{packageId} {
      allow read, write: if request.auth != null;
    }
    match /packagePricing/{packageId} {
      allow read, write: if request.auth != null;
    }

    // Enquiries: Customers can create new enquiries; Admins can manage all
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Receipts: Public can read for QR verification; Only Admins can issue/revoke
    match /receipts/{receiptId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Destinations & Settings
    match /destinations/{destId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /companySettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
